---
// src/pages/models/[id].astro
import Layout from "../../layouts/Layout.astro";
import { getWorkImageUrl, getWorkThumbUrl } from "../../lib/worksCompat";
import modelsData from "../../data/models.json";
import worksData from "../../data/works.json";

export function getStaticPaths() {
  return modelsData.map((model) => ({
    params: { id: model.id },
  }));
}

const { id } = Astro.params;
const model = modelsData.find((m) => m.id === id);

if (!model) throw new Error(`Model not found: ${id}`);

// 同名モデルがいる場合は所属を補足
const hasDuplicateName = modelsData.filter((m) => m.name === model.name).length > 1;
const displayName = hasDuplicateName && model.agency
  ? `${model.name}（${model.agency}）`
  : model.name;

// 出演作品（新しい順）
const relatedWorks = worksData
  .filter((work) => {
    const workModelIds = Array.isArray(work.modelIds)
      ? work.modelIds
      : work.models || [];

    return workModelIds.includes(model.id);
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const links = model.links || {};

function getAccountLabel(url, options = { prefix: "" }) {
  if (!url) return "";
  try {
    const parsed = new URL(url);
    const label = parsed.pathname.replace(/^\/+|\/+$/g, "");
    const account = label.split("/").pop();
    return account ? `${options.prefix}${account}` : "";
  } catch {
    return url;
  }
}

const socialLinks = [];

if (links.twitter) {
  socialLinks.push({
    label: "X",
    value: getAccountLabel(links.twitter, { prefix: "@" }),
    href: links.twitter,
  });
}

if (links.instagram) {
  socialLinks.push({
    label: "Instagram",
    value: getAccountLabel(links.instagram),
    href: links.instagram,
  });
}

if (links.website) {
  socialLinks.push({
    label: "Website",
    value: "Official",
    href: links.website,
  });
}
---

<Layout title={displayName} currentPath="/models">
  <a href="/models/" class="back-link">← Models</a>

  <!-- プロフィール -->
  <div class="model-profile">
    <div class="model-profile-image">
      <img
        src={`/images/models/${model.thumbnail}`}
        alt={displayName}
      />
    </div>

    <div class="model-profile-info">
      <h1 class="model-profile-name">{model.name}</h1>

      {hasDuplicateName && model.agency && (
        <p class="model-profile-agency">{model.agency}</p>
      )}
      {!hasDuplicateName && model.agency && (
        <p class="model-profile-agency">{model.agency}</p>
      )}

      {model.bio && (
        <p class="model-profile-bio">{model.bio}</p>
      )}

      {socialLinks.length > 0 && (
        <section class="model-section model-social" aria-labelledby="model-social-title">
          <p class="model-section-label">Links</p>
          <h2 id="model-social-title">SNS</h2>
          <div class="model-social-links">
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <span>{link.value}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <!-- 出演作品 -->
  {relatedWorks.length > 0 && (
    <section class="model-section model-works" aria-labelledby="model-works-title">
      <p class="model-section-label">Works</p>
      <h2 id="model-works-title">Works</h2>
      <div class="work-grid">
        {relatedWorks.map((work) => (
          <a href={`/works/${work.id}/`} class="work-card">
            <div class="work-card-image">
              <img
                src={getWorkThumbUrl(work) || getWorkImageUrl(work) || ""}
                alt={work.title}
                loading="lazy"
              />
            </div>
            <div class="work-card-info">
              <p class="work-card-title">{work.title}</p>
              <p class="work-card-meta">{work.date}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .model-section {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid #e8e0f2;
  }

  .model-works {
    margin-top: 3.5rem;
  }

  .model-section-label {
    margin-bottom: 0.45rem;
    color: #8a74a8;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .model-section h2 {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .model-social-links {
    display: grid;
    gap: 0.8rem;
  }

  .model-social-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid #e8e0f2;
    color: #111;
  }

  .model-social-links a:last-child {
    border-bottom: 1px solid #e8e0f2;
  }

  .model-social-links span {
    color: #8a74a8;
    text-align: right;
    overflow-wrap: anywhere;
  }

  @media (max-width: 520px) {
    .model-social-links a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
    }

    .model-social-links span {
      text-align: left;
    }
  }
</style>
