---
// src/pages/models/[id].astro
import Layout from "../../layouts/Layout.astro";
import { getWorkImageUrl, getWorkThumbUrl } from "../../lib/worksCompat";
import modelsData from "../../data/models.json";
import worksData from "../../data/works.json";

export function getStaticPaths() {
  return modelsData.map((model) => ({
    params: { id: model.id },
  }));
}

const { id } = Astro.params;
const model = modelsData.find((m) => m.id === id);

if (!model) throw new Error(`Model not found: ${id}`);

// 同名モデルがいる場合は所属を補足
const hasDuplicateName = modelsData.filter((m) => m.name === model.name).length > 1;
const displayName = hasDuplicateName && model.agency
  ? `${model.name}（${model.agency}）`
  : model.name;
const profileImagePosition = model.profileImagePosition || "center";
const profileImageShift = profileImagePosition === "left center"
  ? "0%"
  : profileImagePosition === "right center"
    ? "-10%"
    : "-5%";

// 出演作品（新しい順）
const relatedWorks = worksData
  .filter((work) => {
    const workModelIds = Array.isArray(work.modelIds)
      ? work.modelIds
      : work.models || [];

    return workModelIds.includes(model.id);
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const links = model.links || {};

function getAccountLabel(url, options = { prefix: "" }) {
  if (!url) return "";
  try {
    const parsed = new URL(url);
    const label = parsed.pathname.replace(/^\/+|\/+$/g, "");
    const account = label.split("/").pop();
    return account ? `${options.prefix}${account}` : "";
  } catch {
    return url;
  }
}

function getWebsiteLabel(url, label = "") {
  const explicitLabel = String(label || "").trim();
  if (explicitLabel) return explicitLabel;
  if (!url) return "";

  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");
    if (host === "lit.link") return "lit.link";
    if (host === "linktr.ee") return "Linktree";
    return host || "Website";
  } catch {
    return "Website";
  }
}

const socialLinks = [];

function extractSocialHandleFromUrl(value, service) {
  try {
    const parsed = new URL(value);
    const parts = parsed.pathname.split("/").map((part) => part.trim()).filter(Boolean);
    if (!parts.length) return "";
    const host = parsed.hostname.replace(/^www\./i, "").toLowerCase();
    if (service === "x" && (host === "x.com" || host === "twitter.com")) return parts[0].replace(/^@/, "");
    if (service === "instagram" && host === "instagram.com") return parts[0].replace(/^@/, "");
    if (service === "threads" && host === "threads.net") return parts[0].replace(/^@/, "");
    return "";
  } catch {
    return "";
  }
}

function normalizeSocialUrl(value, service) {
  const raw = String(value || "").trim();
  if (!raw) return "";

  const urlHandle = /^https?:\/\//i.test(raw) ? extractSocialHandleFromUrl(raw, service) : "";
  const handle = (urlHandle || raw).replace(/^@/, "").replace(/\/+$/g, "").trim();
  if (!handle) return "";

  if (service === "x") return `https://x.com/${handle}`;
  if (service === "instagram") return `https://www.instagram.com/${handle}`;
  if (service === "threads") return `https://www.threads.net/@${handle}`;
  return raw;
}

if (links.x || links.twitter) {
  const href = normalizeSocialUrl(links.x || links.twitter, "x");
  socialLinks.push({
    label: "X",
    value: getAccountLabel(href, { prefix: "@" }),
    href,
  });
}

if (links.instagram) {
  const href = normalizeSocialUrl(links.instagram, "instagram");
  socialLinks.push({
    label: "Instagram",
    value: getAccountLabel(href),
    href,
  });
}

if (links.threads) {
  const href = normalizeSocialUrl(links.threads, "threads");
  socialLinks.push({
    label: "Threads",
    value: getAccountLabel(href, { prefix: "@" }),
    href,
  });
}

if (links.website) {
  socialLinks.push({
    label: "Other",
    value: getWebsiteLabel(links.website, links.websiteLabel),
    href: links.website,
  });
}
---

<Layout title={displayName} currentPath="/models">
  <a href="/models/" class="back-link">← Models</a>

  <!-- プロフィール -->
  <div class="model-profile">
    <div class="model-profile-image">
      <img
        src={`/images/models/${model.thumbnail}`}
        alt={displayName}
        style={`--profile-image-position: ${profileImagePosition}; --profile-image-shift: ${profileImageShift};`}
      />
    </div>

    <div class="model-profile-info">
      <h1 class="model-profile-name">{model.name}</h1>

      {hasDuplicateName && model.agency && (
        <p class="model-profile-agency">{model.agency}</p>
      )}
      {!hasDuplicateName && model.agency && (
        <p class="model-profile-agency">{model.agency}</p>
      )}

      {model.bio && (
        <p class="model-profile-bio">{model.bio}</p>
      )}

      {socialLinks.length > 0 && (
        <section class="model-section model-social" aria-labelledby="model-social-title">
          <p class="model-section-label">Links</p>
          <h2 id="model-social-title">SNS</h2>
          <div class="model-social-links">
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <span>{link.value}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <!-- 出演作品 -->
  {relatedWorks.length > 0 && (
    <section class="model-section model-works" aria-labelledby="model-works-title">
      <p class="model-section-label">Works</p>
      <h2 id="model-works-title">Works</h2>
      <div class="work-grid">
        {relatedWorks.map((work) => (
          <a href={`/works/${work.id}/`} class="work-card">
            <div class="work-card-image">
              <img
                src={getWorkThumbUrl(work) || getWorkImageUrl(work) || ""}
                alt={work.title}
                loading="lazy"
              />
            </div>
            <div class="work-card-info">
              <p class="work-card-title">{work.title}</p>
              <p class="work-card-meta">{work.date}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: #8a74a8;
    font-size: 0.9rem;
  }

  .model-profile {
    display: grid;
    gap: 1.8rem;
    width: min(100%, 920px);
    margin-inline: auto;
    padding-top: 0.5rem;
  }

  .model-profile-image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f1eef7;
  }

  .model-profile-image img {
    width: 110%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: var(--profile-image-position, center);
    transform: translateX(var(--profile-image-shift, -5%));
  }

  .model-profile-info {
    min-width: 0;
  }

  .model-profile-name {
    margin: 0;
    font-size: clamp(2rem, 10vw, 4rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.25;
  }

  .model-profile-agency {
    margin: 0.8rem 0 0;
    color: #8a74a8;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .model-profile-bio {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    color: #444;
    line-height: 2;
  }

  .model-section {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid #e8e0f2;
  }

  .model-works {
    margin-top: 3.5rem;
  }

  .model-section-label {
    margin-bottom: 0.45rem;
    color: #8a74a8;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .model-section h2 {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .model-social-links {
    display: grid;
    gap: 0.8rem;
  }

  .model-social-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid #e8e0f2;
    color: #111;
  }

  .model-social-links a:last-child {
    border-bottom: 1px solid #e8e0f2;
  }

  .model-social-links span {
    color: #8a74a8;
    text-align: right;
    overflow-wrap: anywhere;
  }

  @media (min-width: 720px) {
    .model-profile {
      grid-template-columns: minmax(320px, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3rem);
      padding-top: 1.5rem;
    }

    .model-social {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 520px) {
    .model-social-links a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
    }

    .model-social-links span {
      text-align: left;
    }
  }
</style>
