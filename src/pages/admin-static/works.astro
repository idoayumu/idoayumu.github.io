---
import "../../styles/admin-static.css";
import worksData from "../../data/works.json";
import modelsData from "../../data/models.json";
import { getWorkImageUrl, getWorkThumbUrl } from "../../lib/worksCompat";

const modelById = new Map(modelsData.map((model) => [model.id, model]));
const works = [...worksData]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map((work) => {
    const modelIds = Array.isArray(work.modelIds) ? work.modelIds : work.models || [];
    const modelNames = modelIds.map((id) => modelById.get(id)?.name || id);
    return {
      ...work,
      modelIds,
      modelNames,
      thumbUrl: getWorkThumbUrl(work) || getWorkImageUrl(work) || "",
    };
  });

const payload = JSON.stringify({ works }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>作品一覧 | 静的admin</title>
  </head>
  <body class="admin-static-body" data-admin-static-page="works">
    <main class="admin-static-shell">
      <nav class="admin-static-nav" aria-label="静的adminナビゲーション">
        <a class="admin-static-title" href="/admin-static/">光景ノオト 静的admin</a>
        <div class="admin-static-links">
          <a href="/admin-static/">Top</a>
          <a class="is-active" href="/admin-static/works/">Works</a>
          <a href="/admin-static/models/">Models</a>
          <a href="/admin-static/register/">Register Preview</a>
        </div>
      </nav>

      <header class="admin-static-header">
        <h1>作品一覧</h1>
        <p>{works.length}件の作品を静的データから表示しています。</p>
      </header>

      <label class="admin-static-search">
        検索
        <input id="adminStaticSearch" type="search" placeholder="タイトル・モデル・撮影地・日付で検索" autocomplete="off" />
      </label>

      <section id="adminStaticList" class="admin-static-list" aria-live="polite"></section>
    </main>

    <script id="adminStaticData" type="application/json" set:html={payload}></script>
    <script src="/admin-static/admin-static.js" defer></script>
  </body>
</html>
