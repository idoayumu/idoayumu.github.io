---
import "../../styles/admin-static.css";
import worksData from "../../data/works.json";
import modelsData from "../../data/models.json";

const works = worksData;
const models = [...modelsData]
  .map((model) => {
    const workCount = works.filter((work) => {
      const modelIds = Array.isArray(work.modelIds) ? work.modelIds : work.models || [];
      return modelIds.includes(model.id);
    }).length;
    return { ...model, workCount };
  })
  .sort((a, b) => {
    const aKey = String(a.nameKana || a.name || a.id).normalize("NFKC");
    const bKey = String(b.nameKana || b.name || b.id).normalize("NFKC");
    return aKey.localeCompare(bKey, "ja") || a.id.localeCompare(b.id);
  });

const payload = JSON.stringify({ models }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>モデル一覧 | 静的admin</title>
  </head>
  <body class="admin-static-body" data-admin-static-page="models">
    <main class="admin-static-shell">
      <nav class="admin-static-nav" aria-label="静的adminナビゲーション">
        <a class="admin-static-title" href="/admin-static/">光景ノオト 静的admin</a>
        <div class="admin-static-links">
          <a href="/admin-static/">Top</a>
          <a href="/admin-static/works/">Works</a>
          <a class="is-active" href="/admin-static/models/">Models</a>
          <a href="/admin-static/register/">Register Preview</a>
        </div>
      </nav>

      <header class="admin-static-header">
        <h1>モデル一覧</h1>
        <p>{models.length}件のモデルを静的データから表示しています。</p>
      </header>

      <label class="admin-static-search">
        検索
        <input id="adminStaticSearch" type="search" placeholder="表示名・所属・SNS・モデルIDで検索" autocomplete="off" />
      </label>

      <section id="adminStaticList" class="admin-static-list" aria-live="polite"></section>
    </main>

    <script id="adminStaticData" type="application/json" set:html={payload}></script>
    <script src="/admin-static/admin-static.js" defer></script>
  </body>
</html>
