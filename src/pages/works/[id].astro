---
import Layout from "../../layouts/Layout.astro";
import { getWorkImageUrl, getWorkThumbUrl } from "../../lib/worksCompat";
import worksData from "../../data/works.json";
import modelsData from "../../data/models.json";

export function getStaticPaths() {
  return worksData.map((work) => ({
    params: { id: work.id },
  }));
}

const { id } = Astro.params;
const work = worksData.find((w) => w.id === id);

if (!work) {
  throw new Error(`Work not found: ${id}`);
}

const workModelIds = Array.isArray(work.modelIds) ? work.modelIds : work.models || [];

const relatedModels = modelsData.filter(
  (model) => workModelIds.includes(model.id)
);

const workImages = Array.isArray(work.files)
  ? work.files.map((file) => ({
      src: `/images/works/large/${file.name}`,
      alt: file.alt || work.title,
    }))
  : [
      {
        src: getWorkImageUrl(work) || getWorkThumbUrl(work) || "",
        alt: work.title,
      },
    ].filter((image) => image.src);
const shouldShowProduction = Boolean(work.production && work.production !== "リク撮");
---

<Layout title={work.title}>
  <article class="work-detail">
    <h1>{work.title}</h1>

    {work.date && <p class="work-date">{work.date}</p>}
    {shouldShowProduction && <p class="work-production">{work.production}</p>}

    {relatedModels.length > 0 && (
      <p class="work-models">
        モデル：
        {relatedModels.map((model, index) => (
          <>
            <a href={`/models/${model.id}/`}>{model.name}</a>
            {index < relatedModels.length - 1 ? " / " : ""}
          </>
        ))}
      </p>
    )}

    <div class="work-images">
      {workImages.map((image) => (
        <img
          src={image.src}
          alt={image.alt}
          class="work-image"
        />
      ))}
    </div>

    {work.tags?.length > 0 && (
      <ul class="work-tags">
        {work.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
  </article>
</Layout>
