---
import Layout from "../../layouts/Layout.astro";
import worksData from "../../data/works.json";
import modelsData from "../../data/models.json";
import { getWorkImageUrl, getWorkThumbUrl } from "../../lib/worksCompat";

const works = [...worksData]
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .map((work) => {
  const workModelIds = Array.isArray(work.modelIds) ? work.modelIds : work.models || [];

  const relatedModels = modelsData.filter(
    (model) => workModelIds.includes(model.id)
  );

  return {
    ...work,
    modelNames: relatedModels.map((model) => model.name).join("・"),
    thumbUrl: getWorkThumbUrl(work) || getWorkImageUrl(work) || "",
    thumbAlt: work.files?.[0]?.alt || work.title,
  };
});
---

<Layout title="Works | 光の記録　ー光景ノオトー">
  <section>
    <h1>Works</h1>
    <p>{works.length}作品</p>

    <div class="works-grid">
      {works.map((work) => (
        <a href={`/works/${work.id}/`} class="work-card">
          <div class="work-thumb-wrap">
            {work.thumbUrl && (
              <img
                src={work.thumbUrl}
                alt={work.thumbAlt}
                class="work-thumb"
              />
            )}
          </div>
          <h3>{work.title}</h3>
          <p class="work-meta">
            {work.modelNames && `${work.modelNames} ・ `}{work.date}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
