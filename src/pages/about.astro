---
import Layout from "../layouts/Layout.astro";
import siteSettings from "../data/site-settings.json";

const conceptImage = siteSettings.aboutImage || "/images/site/about/2026_spring_001.webp";
const conceptImageMemo = siteSettings.aboutImageMemo?.trim();
const conceptNoteDate = "2026.06.16";
---

<Layout title="About | 光の記録 ー光景ノオトー">
  <section class="about-hero" aria-labelledby="about-title">
    <p class="about-label">About</p>
    <h1 id="about-title">井戸歩について</h1>
    <div class="about-profile">
      <p class="about-name">井戸歩</p>
      <p class="about-role">ハイパーメディアクリエイティブフォトグラファー</p>
      <div class="about-profile-copy">
        <p>京都を拠点に、<br />光景ポートレートを撮影しています。</p>
        <p>人と光が出会う一瞬を、<br />静かな記録として残しています。</p>
      </div>
    </div>
  </section>

  <section class="about-concept" aria-labelledby="concept-title">
    <div class="about-concept-copy">
      <p class="about-label">Concept</p>
      <h2 id="concept-title">光景ポートレート。</h2>
      <div class="about-concept-text">
        <p>光景ポートレート。</p>
        <p>
          人物を主役にしながらも、そこに差す光、空気、<span class="no-break">余白</span>、
          そして時の気配まで写しとること。
        </p>
        <p>「写真は真を写すのではなく、光を写す。」</p>
      </div>
      <div class="about-concept-body">
        <div class="about-concept-item">
          <h3>私と光景ポートレート。</h3>
          <div class="about-concept-text">
            <p>眠れない夜、私は光景ポートレートについて<span class="no-break">考えることがある。</span></p>
            <p>
              電球、街灯、ビルや家の灯り。<br />
              この街の光、地球の光、太陽や月の光。
            </p>
            <p>
              私はこれまで、<br class="mobile-break" />
              多くの人物の魅力に惹かれ、<br class="mobile-break" />
              <span class="no-break">シャッター</span>を切ってきた<br class="mobile-break" />
              だけでなく、<br class="mobile-break" />
              無数の光にも惹かれて<br class="mobile-break" />
              作品を作ってきた。
            </p>
            <p>
              人物の瞳に宿る光と頬にある影。<br />
              木々の隙間から溢れる光。<br />
              ひとつひとつが重なった時、<br class="mobile-break" />
              その場に満ちる光や<br class="mobile-break" />
              <span class="no-break">空気</span>が輝きだす。
            </p>
            <p>その瞬間、人と光が結びついた時に私は<span class="no-break">シャッターを切る。</span></p>
            <p>この煌めくような美しさを、私は光景ポートレートと<span class="no-break">呼んでいる。</span></p>
            <p>今日も、私は光を追いかけ続けている。</p>
            <p class="about-concept-date">{conceptNoteDate}</p>
          </div>
        </div>
        <div class="about-concept-image">
          <img src={conceptImage} alt="光景ポートレートの代表作品" loading="lazy" />
          {conceptImageMemo && <p>{conceptImageMemo}</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="about-section" aria-labelledby="gear-title">
    <p class="about-label">Gear</p>
    <h2 id="gear-title">主な使用機材</h2>
    <div class="about-gear-grid">
      <section class="about-gear-system" aria-label="Canon system">
        <h3>Canon EOS R6 Mark II</h3>
        <ul>
          <li>EF70-200mm F2.8</li>
          <li>RF35mm F1.4</li>
        </ul>
      </section>

      <section class="about-gear-system" aria-label="FUJIFILM system">
        <h3>FUJIFILM X-T5</h3>
        <ul>
          <li>XF56mm F1.2</li>
          <li>XF35mm F1.4</li>
        </ul>
      </section>
    </div>
  </section>

  <section class="about-section" aria-labelledby="sns-title">
    <p class="about-label">Links</p>
    <h2 id="sns-title">SNS</h2>
    <div class="about-social-links">
      <a href="https://x.com/huran_1212" target="_blank" rel="noopener noreferrer">
        X <span>@huran_1212</span>
      </a>
      <a href="https://www.instagram.com/ido_ayumu/" target="_blank" rel="noopener noreferrer">
        Instagram <span>ido_ayumu</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-hero,
  .about-concept,
  .about-section {
    width: min(100%, 820px);
    margin-inline: auto;
  }

  .about-hero {
    padding: 1.25rem 0 3rem;
  }

  .about-label {
    margin-bottom: 0.7rem;
    color: #8a74a8;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .about-hero h1 {
    margin-bottom: 2rem;
    font-size: clamp(2.2rem, 11vw, 4.4rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.25;
  }

  .about-profile {
    display: grid;
    gap: 0.65rem;
    max-width: 42rem;
  }

  .about-profile p {
    margin: 0;
  }

  .about-name {
    font-size: 1.25rem;
    letter-spacing: 0.08em;
  }

  .about-role {
    color: #8a74a8;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .about-profile-copy {
    display: grid;
    gap: 1rem;
  }

  .about-profile-copy p {
    color: #444;
    line-height: 2.05;
  }

  .about-profile-copy p:last-child {
    color: #444;
    line-height: 2.05;
  }

  .about-concept {
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid #e8e0f2;
  }

  .about-concept h2,
  .about-section h2 {
    margin: 0 0 1.4rem;
    font-size: clamp(1.45rem, 7vw, 2.35rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .about-concept-text {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
  }

  .about-concept-body {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.4rem;
    padding-top: 1.8rem;
    border-top: 1px solid #e8e0f2;
  }

  .about-concept-item h3 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.22rem, 5vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.45;
  }

  .about-concept-text p {
    margin: 0;
    color: #444;
    line-height: 2;
  }

  .about-concept-item .about-concept-text p {
    line-height: 1.95;
  }

  .no-break {
    white-space: nowrap;
  }

  .mobile-break {
    display: none;
  }

  .about-concept-text p:first-child,
  .about-concept-text p:last-child:not(.about-concept-date) {
    color: #111;
    font-size: 1.08rem;
  }

  .about-concept-date {
    margin-top: 0.15rem;
    color: #8a74a8;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }

  .about-concept-image {
    min-width: 0;
    overflow: hidden;
    background: transparent;
  }

  .about-concept-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
  }

  .about-concept-image p {
    margin: 0;
    padding: 0.7rem 0 0;
    overflow: hidden;
    background: transparent;
    color: #6f647d;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .about-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e8e0f2;
  }

  .about-gear-grid {
    display: grid;
    gap: 1.6rem;
  }

  .about-gear-system {
    padding-top: 1rem;
    border-top: 1px solid #e8e0f2;
  }

  .about-gear-system h3 {
    margin-bottom: 1rem;
    color: #111;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.55;
  }

  .about-gear-system ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-gear-system li {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .about-gear-system li::before {
    content: "";
    display: inline-block;
    width: 1.4rem;
    height: 1px;
    margin-right: 0.65rem;
    vertical-align: middle;
    background: #b9a5d4;
  }

  .about-social-links {
    display: grid;
    gap: 0.8rem;
  }

  .about-social-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid #e8e0f2;
    color: #111;
  }

  .about-social-links a:last-child {
    border-bottom: 1px solid #e8e0f2;
  }

  .about-social-links span {
    color: #8a74a8;
  }

  @media (min-width: 720px) {
    .about-hero {
      padding-top: 2.5rem;
      width: min(100%, 980px);
    }

    .about-hero h1 {
      font-size: clamp(2.2rem, 6vw, 3.9rem);
    }

    .about-concept {
      width: min(100%, 980px);
    }

    .about-concept-body {
      grid-template-columns: minmax(0, 1.32fr) minmax(280px, 0.76fr);
      align-items: start;
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .about-gear-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (max-width: 719px) {
    .about-concept-image {
      order: -1;
    }

    .mobile-break {
      display: initial;
    }
  }
</style>
